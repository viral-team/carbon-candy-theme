        "foreground": "#8ffcff"
      }
    },
    {
      "name": "JSON constant",
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#d5b2ff"
      }
    },
    {
      "name": "Markup heading",
      "scope": "markup.heading",
      "settings": {
