        "foreground": "#9ffcff"
      }
    },
    {
      "name": "Type",
      "scope": "entity.name.type, entity.other.inherited-class, entity.other",
      "settings": {
        "foreground": "#9ffcff"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#7aa4b3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment punctuation",
      "scope": "comment punctuation.definition.comment",
      "settings": {
        "foreground": "#7aa4b3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class",
      "scope": "entity.name, entity.name.type.class, support.type, support.class, meta.use",
      "settings": {
        "foreground": "#9ffcff"
      }
    },
    {
      "name": "Class variable",
