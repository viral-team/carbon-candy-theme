  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Global settings",
      "settings": {
        "background": "#07101a",
        "foreground": "#d8f8ff"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#7af2ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, constant.other.symbol",
      "settings": {
        "foreground": "#8cf7ff"
      }
    },
    {
      "name": "String Escape",
      "scope": "constant.character.escape, text.html constant.character.entity.named",
      "settings": {
        "foreground": "#d8f8ff"
      }
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#8fffb7"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#ffd86b"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, variable.parameter, support.variable, variable.language, support.constant, meta.definition.variable entity.name.function, meta.function-call.arguments",
      "settings": {
        "foreground": "#d8f8ff"
      }
    },
    {
      "name": "Other Keyword",
      "scope": "keyword.other",
      "settings": {
        "foreground": "#8ff2ff"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
      "settings": {
        "foreground": "#9aefff"
      }
    },
    {
      "name": "Function call",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#befcff"
      }
    },
    {
      "name": "Storage",
      "scope": "storage.type, storage.modifier, storage.control",
      "settings": {
        "foreground": "#d67cff"
      }
    },
    {
      "name": "Modules",
      "scope": "support.module, support.node",
      "settings": {
        "foreground": "#b6b3ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type",
      "scope": "support.type, constant.other.key",
      "settings": {
        "foreground": "#8defff"
      }
    },
    {
      "name": "Type",
      "scope": "entity.name.type, entity.other.inherited-class, entity.other",
      "settings": {
        "foreground": "#8defff"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#5d8d9d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment punctuation",
      "scope": "comment punctuation.definition.comment",
      "settings": {
        "foreground": "#5d8d9d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class",
      "scope": "entity.name, entity.name.type.class, support.type, support.class, meta.use",
      "settings": {
        "foreground": "#8defff"
      }
    },
    {
      "name": "Class variable",
      "scope": "variable.object.property, meta.field.declaration entity.name.function",
      "settings": {
        "foreground": "#8afcff"
      }
    },
    {
      "name": "Function definition",
      "scope": "meta.function entity.name.function",
      "settings": {
        "foreground": "#befcff"
      }
    },
    {
      "name": "JSON Key",
      "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
      "settings": {
        "foreground": "#8cf2ff"
      }
    },
    {
      "name": "JSON constant",
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#d67cff"
      }
    },
    {
      "name": "Markup heading",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#8cf7ff"
      }
    }
  ]
}
