                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#b58900"
            }
        },
        {
            "scope": [
                "variable"
            ],
            "settings": {
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#b58900"
            }
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "background": "#dc322f",
                "fontStyle": "",
                "foreground": "#fdf6e3"
            }
        },
        {
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "background": "#6c71c4",
                "fontStyle": "",
                "foreground": "#fdf6e3"
