  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Global settings",
      "settings": {
        "background": "#07140b",
        "foreground": "#dafecc"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#b7ff6e"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, constant.other.symbol",
      "settings": {
        "foreground": "#7ef2aa"
      }
    },
    {
      "name": "String Escape",
      "scope": "constant.character.escape, text.html constant.character.entity.named",
      "settings": {
        "foreground": "#dafecc"
      }
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#8dff93"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#d7ff74"
      }
    },
    {
      "name": "Variable",
      "scope": "variable, variable.parameter, support.variable, variable.language, support.constant, meta.definition.variable entity.name.function, meta.function-call.arguments",
      "settings": {
        "foreground": "#dafecc"
      }
    },
    {
      "name": "Other Keyword",
      "scope": "keyword.other",
      "settings": {
        "foreground": "#8dff93"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, modifier, variable.language.this, support.type.object, constant.language",
      "settings": {
        "foreground": "#7ef2aa"
      }
    },
    {
      "name": "Function call",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#d7ff74"
      }
    },
    {
      "name": "Storage",
      "scope": "storage.type, storage.modifier, storage.control",
      "settings": {
        "foreground": "#6eff8f"
      }
    },
    {
      "name": "Modules",
      "scope": "support.module, support.node",
      "settings": {
        "foreground": "#7ef2aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type",
      "scope": "support.type, constant.other.key",
      "settings": {
        "foreground": "#8dff93"
      }
    },
    {
      "name": "Type",
      "scope": "entity.name.type, entity.other.inherited-class, entity.other",
      "settings": {
        "foreground": "#8dff93"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#5c7c5f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment punctuation",
      "scope": "comment punctuation.definition.comment",
      "settings": {
        "foreground": "#5c7c5f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class",
      "scope": "entity.name, entity.name.type.class, support.type, support.class, meta.use",
      "settings": {
        "foreground": "#8dff93"
      }
    },
    {
      "name": "Class variable",
      "scope": "variable.object.property, meta.field.declaration entity.name.function",
      "settings": {
        "foreground": "#7ef2aa"
      }
    },
    {
      "name": "Function definition",
      "scope": "meta.function entity.name.function",
      "settings": {
        "foreground": "#d7ff74"
      }
    },
    {
      "name": "JSON Key",
      "scope": "meta.object-literal.key, meta.object-literal.key string, support.type.property-name.json",
      "settings": {
        "foreground": "#7ef2aa"
      }
    },
    {
      "name": "JSON constant",
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#6eff8f"
      }
    },
    {
      "name": "Markup heading",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#7ef2aa"
      }
    }
  ]
}
